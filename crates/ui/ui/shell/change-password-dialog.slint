// Skedari → Ndrysho fjalëkalimin…

import { LineEdit } from "std-widgets.slint";
import { DialogButton, Theme } from "../shared/theme.slint";
import { LabeledField } from "../shared/labeled-field.slint";

export component ChangePasswordDialog inherits Dialog {
    title: "Ndrysho fjalëkalimin";
    in-out property <string> error;
    callback submit(current: string, new-password: string, repeat: string);
    callback cancel();
    // Fixed width; the height follows the content, so the window manager sees a fixed-size
    // dialog (Hyprland floats it, Windows shows a normal dialog) instead of tiling it.
    min-width: Theme.dialog-width-small;
    max-width: Theme.dialog-width-small;
    preferred-width: Theme.dialog-width-small;

    public function clear() {
        current.text = "";
        new-password.text = "";
        repeat.text = "";
        current.focus();
    }

    init => { current.focus(); }

    VerticalLayout {
        height: self.preferred-height;
        alignment: start;
        padding: Theme.dialog-padding;
        spacing: Theme.spacing;

        LabeledField {
            label: "Fjalëkalimi aktual";
            current := LineEdit {
                height: Theme.field-height;
                input-type: password;
                accepted => { new-password.focus(); }
            }
        }
        LabeledField {
            label: "Fjalëkalimi i ri";
            new-password := LineEdit {
                height: Theme.field-height;
                input-type: password;
                accepted => { repeat.focus(); }
            }
        }
        LabeledField {
            label: "Përsërit fjalëkalimin";
            repeat := LineEdit {
                height: Theme.field-height;
                input-type: password;
                accepted => { root.submit(current.text, new-password.text, repeat.text); }
            }
        }
        Text {
            text: root.error;
            color: Theme.error-color;
            wrap: word-wrap;
        }
    }

    ok := DialogButton {
        text: "OK";
        primary: true;
        dialog-button-role: accept;
        clicked => { root.submit(current.text, new-password.text, repeat.text); }
    }
    DialogButton {
        text: "Anulo";
        dialog-button-role: reject;
        clicked => { root.cancel(); }
    }
}
