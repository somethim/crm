// The password screen: the start-up gate (UnlockWindow) and the lock overlay of the main
// window. Modes:
// - "setup" / "migrate": a new password twice (first run; existing plaintext data);
// - "unlock": the password, the recovery key or the wipe code;
// - "new-password": a new password twice after a recovery-key unlock;
// - "codes": the recovery key and the wipe code, shown once, with the confirmation.
// Rust sets the error, the busy state (Argon2 runs on a worker) and bumps `reset` after
// every attempt. Enter submits.

import { Button, CheckBox, LineEdit, Palette } from "std-widgets.slint";
import { Theme } from "../shared/theme.slint";

export component PasswordScreen inherits Rectangle {
    in property <string> mode: "unlock";
    in property <string> error;
    in property <bool> busy;
    in property <int> reset;
    in property <string> recovery-code;
    in property <string> wipe-code;
    callback submit-new(password: string, repeat: string);
    callback submit-entry(entry: string);
    callback codes-confirmed();

    property <bool> two-fields: root.mode == "setup" || root.mode == "migrate" || root.mode == "new-password";
    property <bool> codes: root.mode == "codes";

    background: Palette.background;

    // Swallow every pointer event under the screen.
    TouchArea { }

    function submit() {
        if (root.busy) {
            return;
        }
        if (root.two-fields) {
            root.submit-new(first.text, second.text);
        } else {
            root.submit-entry(first.text);
        }
    }

    function clear() {
        first.text = "";
        second.text = "";
        written.checked = false;
        first.focus();
    }

    changed reset => { root.clear(); }
    changed mode => { root.clear(); }

    init => { first.focus(); }

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: root.codes ? 460px : 340px;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 4px;
                background: Theme.chrome-background;

                VerticalLayout {
                    padding: 20px;
                    spacing: Theme.spacing * 2;

                    Text {
                        text: root.codes ? "Kodet e sigurisë" : "CRM";
                        font-size: 22px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    intro := Text {
                        text: root.mode == "setup" ? "Vendosni një fjalëkalim për programin (të paktën 6 karaktere)."
                            : root.mode == "migrate" ? "Të dhënat ekzistuese do të enkriptohen. Vendosni një fjalëkalim (të paktën 6 karaktere)."
                            : root.mode == "new-password" ? "U hap me çelësin e rikuperimit. Vendosni një fjalëkalim të ri."
                            : root.codes ? "Shkruajini këto dy kode në letër dhe ruajini larg USB-së. Shfaqen vetëm tani."
                            : "Programi është i kyçur.";
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    if root.codes: VerticalLayout {
                        spacing: Theme.spacing;

                        Text {
                            text: "Çelësi i rikuperimit — hap të dhënat nëse harroni fjalëkalimin:";
                            wrap: word-wrap;
                        }
                        recovery := Text {
                            text: root.recovery-code;
                            font-family: "Consolas";
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Kodi i fshirjes emergjente — po ta shkruani në vend të fjalëkalimit, të gjitha të dhënat fshihen përgjithmonë:";
                            wrap: word-wrap;
                        }
                        wipe := Text {
                            text: root.wipe-code;
                            font-family: "Consolas";
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Pa fjalëkalimin dhe pa çelësin e rikuperimit, të dhënat nuk mund të rikthehen.";
                            wrap: word-wrap;
                        }
                    }

                    if !root.codes: Text {
                        text: root.two-fields ? "Fjalëkalimi i ri" : "Shkruani fjalëkalimin";
                    }

                    first := LineEdit {
                        visible: !root.codes;
                        height: root.codes ? 0 : self.preferred-height;
                        enabled: !root.busy;
                        input-type: password;
                        accepted => {
                            if (root.two-fields) {
                                second.focus();
                            } else {
                                root.submit();
                            }
                        }
                    }

                    if root.two-fields: Text {
                        text: "Përsërit fjalëkalimin";
                    }

                    second := LineEdit {
                        visible: root.two-fields;
                        height: root.two-fields ? first.preferred-height : 0;
                        enabled: !root.busy;
                        input-type: password;
                        accepted => { root.submit(); }
                    }

                    written := CheckBox {
                        visible: root.codes;
                        height: root.codes ? self.preferred-height : 0;
                        text: "I kam shkruar kodet";
                    }

                    error := Text {
                        text: root.busy ? "Duke kontrolluar…" : root.error;
                        color: root.busy ? Palette.foreground : Theme.error-color;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    if !root.codes: ok := Button {
                        text: root.mode == "unlock" ? "Hap" : "Ruaj";
                        primary: true;
                        enabled: !root.busy;
                        clicked => { root.submit(); }
                    }

                    if root.codes: next := Button {
                        text: "Vazhdo";
                        primary: true;
                        enabled: written.checked && !root.busy;
                        clicked => { root.codes-confirmed(); }
                    }
                }
            }
        }
    }
}
