// A yes/no question with an Albanian OK label and "Anulo".

import { DialogButton, Theme } from "theme.slint";

export component ConfirmDialog inherits Dialog {
    in property <string> caption: "CRM";
    in property <string> text;
    title: root.caption;
    in property <string> ok-label: "OK";
    callback answered(ok: bool);
    // Fixed width; the height follows the content, so the window manager sees a fixed-size
    // dialog (Hyprland floats it, Windows shows a normal dialog) instead of tiling it.
    min-width: Theme.dialog-width-small;
    max-width: Theme.dialog-width-small;
    preferred-width: Theme.dialog-width-small;

    VerticalLayout {
        height: self.preferred-height;
        alignment: start;
        padding: Theme.dialog-padding;
        Text {
            text: root.text;
            wrap: word-wrap;
        }
    }

    ok := DialogButton {
        text: root.ok-label;
        primary: true;
        dialog-button-role: accept;
        clicked => { root.answered(true); }
    }

    cancel := DialogButton {
        text: "Anulo";
        dialog-button-role: reject;
        clicked => { root.answered(false); }
    }
}
