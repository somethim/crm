// Rendered by apps/crm/build.rs into OUT_DIR/crm.rc. Placeholders: @ICON@,
// @MANIFEST@ (absolute paths), @VERSION_COMMA@ (1,2,3,0) and @VERSION@ (1.2.3).
// Self-contained on purpose: no #include, so llvm-rc needs no SDK headers.

#pragma code_page(65001)

1 ICON "@ICON@"

// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST
1 24 "@MANIFEST@"

// 1 = VS_VERSION_INFO
1 VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ""
            VALUE "FileDescription", "CRM"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "crm"
            VALUE "OriginalFilename", "crm.exe"
            VALUE "ProductName", "CRM"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
